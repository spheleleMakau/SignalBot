# App ID and API token are reserved for future authenticated features.
DERIV_APP_ID=
DERIV_APP_NAME=stepindex
DERIV_REDIRECT_URL=https://your-tunnel.trycloudflare.com
DERIV_API_TOKEN=
# Leave empty: the public feed discovers the selected market via active_symbols.
DERIV_SYMBOL=
HOST=127.0.0.1
PORT=8000
DATABASE_PATH=data/step_index.db
DASHBOARD_USERNAME=
DASHBOARD_PASSWORD=
DASHBOARD_AUTH_REQUIRED=false
MIN_SIGNAL_SCORE=75
# USD for a 1.0 price move at 1.00 lot from the broker's contract spec. Leave blank if unknown.
USD_PER_PRICE_UNIT_PER_LOT=
